<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Quanlyvadatphonghomestay.ThongTinCaNhan"
             Title="Cá Nhân"
             BackgroundColor="#FEF9F2"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <!-- Tiêu đề -->
            <Label Text="Cá Nhân"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="#1D1B18"
                   Margin="0,10,0,10" />

            <!-- Profile Card -->
            <Border BackgroundColor="White"
                    StrokeThickness="0"
                    Padding="20"
                    StrokeShape="RoundRectangle 16">

                <VerticalStackLayout Spacing="8" HorizontalOptions="Center">

                    <!-- Avatar -->
                    <Border WidthRequest="80"
                            HeightRequest="80"
                            StrokeShape="RoundRectangle 40"
                            BackgroundColor="#F7DEC6"
                            HorizontalOptions="Center">
                        <Label Text="👤"
                               FontSize="36"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>

                    <Label Text="{Binding MemberTier}"
                           FontSize="12"
                           TextColor="#73614E"
                           BackgroundColor="#F7DEC6"
                           Padding="12,4"
                           HorizontalOptions="Center" />

                    <Label Text="{Binding FullName}"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="#1D1B18"
                           HorizontalOptions="Center" />

                    <Label Text="{Binding Email}"
                           FontSize="14"
                           TextColor="#51443C"
                           HorizontalOptions="Center" />

                    <Label Text="{Binding Phone}"
                           FontSize="14"
                           TextColor="#51443C"
                           HorizontalOptions="Center" />

                    <Button Text="Chỉnh sửa thông tin"
                            BackgroundColor="#F8F3ED"
                            TextColor="#6F4627"
                            CornerRadius="20"
                            Padding="16,10"
                            HorizontalOptions="Center"
                            Margin="0,8,0,0"
                            Clicked="OnEditProfileClicked" />
                </VerticalStackLayout>
            </Border>

            <!-- Tài khoản của tôi -->
            <Label Text="TÀI KHOẢN CỦA TÔI"
                   FontSize="12"
                   TextColor="#51443C"
                   Margin="4,8,0,0" />

            <Border BackgroundColor="White"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 16"
                    Padding="0">

                <VerticalStackLayout>
                    <Grid Padding="16" ColumnDefinitions="Auto,*,Auto">
                        <Label Text="👤" FontSize="20" VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" Margin="12,0,0,0" VerticalOptions="Center">
                            <Label Text="Thông tin cá nhân" FontSize="14" TextColor="#1D1B18" />
                            <Label Text="Cập nhật thông tin cá nhân" FontSize="12" TextColor="#51443C" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="›" FontSize="20" TextColor="#83746B" VerticalOptions="Center" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="#ECE7E2" Margin="16,0" />

                    <Grid Padding="16" ColumnDefinitions="Auto,*,Auto">
                        <Label Text="🔒" FontSize="20" VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" Margin="12,0,0,0" VerticalOptions="Center">
                            <Label Text="Đổi mật khẩu" FontSize="14" TextColor="#1D1B18" />
                            <Label Text="Thay đổi mật khẩu đăng nhập" FontSize="12" TextColor="#51443C" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="›" FontSize="20" TextColor="#83746B" VerticalOptions="Center" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="#ECE7E2" Margin="16,0" />

                    <Grid Padding="16" ColumnDefinitions="Auto,*,Auto">
                        <Label Text="📞" FontSize="20" VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" Margin="12,0,0,0" VerticalOptions="Center">
                            <Label Text="Thông tin liên hệ" FontSize="14" TextColor="#1D1B18" />
                            <Label Text="Quản lý số điện thoại và email" FontSize="12" TextColor="#51443C" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="›" FontSize="20" TextColor="#83746B" VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Hoạt động của tôi -->
            <Label Text="HOẠT ĐỘNG CỦA TÔI"
                   FontSize="12"
                   TextColor="#51443C"
                   Margin="4,8,0,0" />

            <Border BackgroundColor="White"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 16"
                    Padding="0">

                <VerticalStackLayout>
                    <Grid Padding="16" ColumnDefinitions="Auto,*,Auto">
                        <Label Text="📅" FontSize="20" VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" Margin="12,0,0,0" VerticalOptions="Center">
                            <Label Text="Đặt phòng của tôi" FontSize="14" TextColor="#1D1B18" />
                            <Label Text="Theo dõi và quản lý các đặt phòng" FontSize="12" TextColor="#51443C" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" 
                               Text="{Binding BookingCount}" 
                               FontSize="12" 
                               TextColor="White"
                               BackgroundColor="#6F4627" 
                               Padding="8,2" 
                               VerticalOptions="Center" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="#ECE7E2" Margin="16,0" />

                    <Grid Padding="16" ColumnDefinitions="Auto,*,Auto">
                        <Label Text="❤️" FontSize="20" VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" Margin="12,0,0,0" VerticalOptions="Center">
                            <Label Text="Yêu thích" FontSize="14" TextColor="#1D1B18" />
                            <Label Text="Homestay bạn đã lưu" FontSize="12" TextColor="#51443C" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" 
                               Text="{Binding FavoriteCount}" 
                               FontSize="12" 
                               TextColor="White"
                               BackgroundColor="#6F4627" 
                               Padding="8,2" 
                               VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Cài đặt -->
            <Label Text="CÀI ĐẶT"
                   FontSize="12"
                   TextColor="#51443C"
                   Margin="4,8,0,0" />

            <Border BackgroundColor="White"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 16"
                    Padding="0">

                <VerticalStackLayout>
                    <Grid Padding="16" ColumnDefinitions="Auto,*,Auto">
                        <Label Text="🔔" FontSize="20" VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" Margin="12,0,0,0" VerticalOptions="Center">
                            <Label Text="Thông báo" FontSize="14" TextColor="#1D1B18" />
                            <Label Text="Quản lý thông báo ứng dụng" FontSize="12" TextColor="#51443C" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="2" 
                                IsToggled="{Binding IsNotificationOn}" 
                                OnColor="#6F4627" 
                                VerticalOptions="Center"
                                Toggled="OnNotificationToggled" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="#ECE7E2" Margin="16,0" />

                    <Grid Padding="16" ColumnDefinitions="Auto,*,Auto">
                        <Label Text="⚙️" FontSize="20" VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" Margin="12,0,0,0" VerticalOptions="Center">
                            <Label Text="Cài đặt ứng dụng" FontSize="14" TextColor="#1D1B18" />
                            <Label Text="Tiếng Việt • Tiền tệ VNĐ" FontSize="12" TextColor="#51443C" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="›" FontSize="20" TextColor="#83746B" VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Nút Đăng xuất -->
            <Button Text="Đăng xuất"
                    BackgroundColor="#FFDAD6"
                    TextColor="#BA1A1A"
                    CornerRadius="12"
                    HeightRequest="48"
                    Margin="0,16,0,0"
                    Clicked="OnLogoutClicked" />

            <!-- Version -->
            <Label Text="StayHome v2.4.0"
                   FontSize="12"
                   TextColor="#51443C"
                   HorizontalOptions="Center"
                   Margin="0,8,0,4" />

            <Label Text="Made with warm hospitality"
                   FontSize="12"
                   TextColor="#83746B"
                   HorizontalOptions="Center"
                   Margin="0,0,0,20" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>