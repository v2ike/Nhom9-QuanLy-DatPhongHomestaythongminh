<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Quanlyvadatphonghomestay"
             xmlns:components="clr-namespace:Quanlyvadatphonghomestay.Components"
             x:Class="Quanlyvadatphonghomestay.TrangChu"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#D6C4B0">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ================= HEADER ================= -->
        <Border Grid.Row="0"
                BackgroundColor="#BFA992"
                Stroke="#52361E"
                StrokeThickness="1"
                Padding="18,14">
            <Border.Shadow>
                <Shadow Brush="#3E2723" Offset="0,2" Radius="6" Opacity="0.15"/>
            </Border.Shadow>

            <Grid ColumnDefinitions="*,Auto">

                <HorizontalStackLayout Spacing="12">

                    <!-- Avatar nút bấm -->
                    <Border WidthRequest="48"
                            HeightRequest="48"
                            Stroke="White"
                            StrokeThickness="2"
                            StrokeShape="RoundRectangle 24"
                            BackgroundColor="#F7DEC6">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="chuyen_thongtincanhan"/>
                        </Border.GestureRecognizers>

                        <Label Text="👤"
                               FontSize="26"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                    </Border>

                    <!-- Lời chào -->
                    <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                        <Label x:Name="HelloLabel"
                               Text="Xin chào 👋"
                               FontFamily="OpenSans-Semibold"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#3E2723"/>

                        <Label Text="Bạn muốn nghỉ ngơi ở đâu hôm nay?"
                               FontSize="12"
                               TextColor="#5D4037"/>
                    </VerticalStackLayout>

                </HorizontalStackLayout>

                <!-- Nút Thông báo -->
                <Border Grid.Column="1"
                        WidthRequest="44"
                        HeightRequest="44"
                        BackgroundColor="#FDF9F4"
                        Stroke="#8B6F47"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 22">
                    <Border.Shadow>
                        <Shadow Brush="#3E2723" Offset="0,2" Radius="4" Opacity="0.1"/>
                    </Border.Shadow>

                    <Label Text="🔔"
                           FontSize="20"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                </Border>

            </Grid>
        </Border>


        <!-- ================= CONTENT ================= -->
        <ScrollView Grid.Row="1">

            <VerticalStackLayout Padding="20,20,20,30" Spacing="26">

                <!-- ================= SEARCH BAR ================= -->
                <Grid ColumnDefinitions="*,52" ColumnSpacing="12">

                    <Border BackgroundColor="#FDFAF6"
                            Stroke="#8B6F47"
                            StrokeThickness="1.5"
                            StrokeShape="RoundRectangle 16">
                        <Border.Shadow>
                            <Shadow Brush="#3E2723" Offset="0,3" Radius="6" Opacity="0.08"/>
                        </Border.Shadow>

                        <Grid ColumnDefinitions="44,*">
                            <Label Text="⌕"
                                   FontSize="26"
                                   TextColor="#8B6F47"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>

                            <Entry x:Name="SearchEntry"
                                   Grid.Column="1"
                                   Placeholder="Tìm kiếm Homestay, địa điểm..."
                                   PlaceholderColor="#8A7A70"
                                   TextColor="#3E3028"
                                   FontSize="14"
                                   BackgroundColor="Transparent"
                                   Completed="SearchEntry_Completed"/>
                        </Grid>
                    </Border>

                    <!-- Nút lọc / tìm kiếm nâng cao -->
                    <Border Grid.Column="1"
                            BackgroundColor="#3E2723"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 16">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="chuyentimkiem"/>
                        </Border.GestureRecognizers>
                        <Border.Shadow>
                            <Shadow Brush="#3E2723" Offset="0,3" Radius="6" Opacity="0.2"/>
                        </Border.Shadow>

                        <Label Text="☷"
                               TextColor="White"
                               FontSize="22"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                    </Border>

                </Grid>


                <!-- ================= LOCATIONS SECTION ================= -->
                <VerticalStackLayout Spacing="12">

                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Khám phá theo địa điểm"
                                   FontFamily="OpenSans-Semibold"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="#3E2723"/>

                            <Label Text="Những điểm đến thư giãn tuyệt vời"
                                   FontSize="13"
                                   TextColor="#685B4F"/>
                        </VerticalStackLayout>

                        <Label Grid.Column="1"
                               Text="Lướt qua ›"
                               TextColor="#8B6F47"
                               FontAttributes="Bold"
                               FontSize="12"
                               VerticalOptions="End"/>
                    </Grid>

                    <!-- Danh sách địa điểm -->
                    <CollectionView ItemsSource="{Binding Locations}"
                                    HeightRequest="200"
                                    SelectionMode="None"
                                    HorizontalOptions="Fill"
                                    HorizontalScrollBarVisibility="Never">

                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="15"/>
                        </CollectionView.ItemsLayout>

                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border WidthRequest="145"
                                        HeightRequest="190"
                                        Padding="0"
                                        Stroke="#8B6F47"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 16">
                                    <Border.Shadow>
                                        <Shadow Brush="#3E2723" Offset="0,4" Radius="8" Opacity="0.15"/>
                                    </Border.Shadow>

                                    <Grid>
                                        <!-- Ảnh địa điểm -->
                                        <Image Source="{Binding ImageUrl}"
                                               Aspect="AspectFill"
                                               HorizontalOptions="Fill"
                                               VerticalOptions="Fill"/>

                                        <!-- Đổ màu tối chuyển dần dưới chân ảnh (Gradient) giúp Tên địa điểm hiển thị sắc nét -->
                                        <Border VerticalOptions="End"
                                                HeightRequest="60"
                                                StrokeThickness="0">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="Transparent" Offset="0.0" />
                                                    <GradientStop Color="#CC000000" Offset="1.0" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>

                                        <!-- Tên địa điểm -->
                                        <VerticalStackLayout VerticalOptions="End"
                                                             Padding="12,8"
                                                             Spacing="2">
                                            <Label Text="{Binding Name}"
                                                   FontFamily="OpenSans-Semibold"
                                                   FontSize="15"
                                                   FontAttributes="Bold"
                                                   TextColor="White"
                                                   LineBreakMode="TailTruncation">
                                                <Label.Shadow>
                                                    <Shadow Brush="Black" Offset="0,1" Radius="3" Opacity="0.5"/>
                                                </Label.Shadow>
                                            </Label>
                                        </VerticalStackLayout>
                                    </Grid>

                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>

                    </CollectionView>

                </VerticalStackLayout>


                <!-- ================= FEATURED HOMESTAYS ================= -->
                <VerticalStackLayout Spacing="12">

                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Homestay nổi bật"
                                   FontFamily="OpenSans-Semibold"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="#3E2723"/>

                            <Label Text="Trải nghiệm nghỉ dưỡng đẳng cấp"
                                   FontSize="13"
                                   TextColor="#685B4F"/>
                        </VerticalStackLayout>

                        <Label Grid.Column="1"
                               Text="Xem thêm ›"
                               TextColor="#8B6F47"
                               FontAttributes="Bold"
                               FontSize="13"
                               VerticalOptions="End"/>
                    </Grid>

                    <!-- Danh sách Homestay -->
                    <CollectionView ItemsSource="{Binding Homestays}"
                                    HeightRequest="340"
                                    SelectionMode="Single"
                                    SelectionChanged="Homestay_SelectionChanged"
                                    HorizontalScrollBarVisibility="Never">

                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="16"/>
                        </CollectionView.ItemsLayout>

                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <components:HomestayCard/>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>

                    </CollectionView>

                </VerticalStackLayout>

            </VerticalStackLayout>

        </ScrollView>

    </Grid>

</ContentPage>