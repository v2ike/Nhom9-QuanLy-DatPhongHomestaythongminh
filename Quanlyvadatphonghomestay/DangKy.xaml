<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Quanlyvadatphonghomestay.DangKy"
             Title="DangKy"
             NavigationPage.HasNavigationBar="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <!-- Áp dụng phông Times New Roman cho toàn bộ Label, Entry, Button -->
            <Style TargetType="Label">
                <Setter Property="FontFamily" Value="Times New Roman" />
            </Style>
            <Style TargetType="Entry">
                <Setter Property="FontFamily" Value="Times New Roman" />
            </Style>
            <Style TargetType="Button">
                <Setter Property="FontFamily" Value="Times New Roman" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>

        <Image
            Source="login.png"
            Aspect="AspectFill" />

        <BoxView
            Opacity="0.50" />

        <ScrollView
            VerticalOptions="Center"
            HorizontalOptions="Center">

            <Border
                WidthRequest="350"
                Padding="32"
                Margin="0,20,0,20"
                BackgroundColor="#EAFDF9F4"
                StrokeThickness="1"
                Stroke="#FFFFFF"
                StrokeShape="RoundRectangle 24">

                <Border.Shadow>
                    <Shadow
                        Brush="#50000000"
                        Offset="0,8"
                        Radius="32"
                        Opacity="0.15" />
                </Border.Shadow>

                <VerticalStackLayout
                    Spacing="0"
                    HorizontalOptions="Fill">

                    <!-- Logo -->
                    <Image
                        Source="logo.png"
                        HeightRequest="120"
                        WidthRequest="120"
                        Aspect="AspectFit"
                        HorizontalOptions="Center"
                        Margin="0,0,0,20" />

                    <!-- Tiêu đề -->
                    <VerticalStackLayout
                        Spacing="6"
                        HorizontalOptions="Center"
                        Margin="0,0,0,28">

                        <Label
                            Text="Tạo tài khoản mới"
                            FontSize="26"
                            FontAttributes="Bold"
                            TextColor="#1C1C19"
                            HorizontalTextAlignment="Center" />

                        <Label
                            Text="Bắt đầu trải nghiệm tuyệt vời cùng chúng tôi"
                            FontSize="14"
                            TextColor="#4E453B"
                            HorizontalTextAlignment="Center" />

                    </VerticalStackLayout>

                    <!-- Trường 1: Họ và tên -->
                    <VerticalStackLayout Spacing="8">
                        <Label
                            Text="HỌ VÀ TÊN"
                            FontSize="12"
                            FontAttributes="Bold"
                            CharacterSpacing="1.5"
                            TextColor="#1C1C19" />

                        <Border
                            HeightRequest="50"
                            BackgroundColor="#FFFFFF"
                            Stroke="#D1C4B7"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 4">

                            <Grid ColumnDefinitions="42,*">
                                <Label
                                    Grid.Column="0"
                                    Text="👤"
                                    FontSize="18"
                                    HorizontalTextAlignment="Center"
                                    VerticalTextAlignment="Center" />

                                <Entry
                                    Grid.Column="1"
                                    x:Name="FullNameEntry"
                                    Placeholder="Nhập họ và tên"
                                    PlaceholderColor="#80756A"
                                    TextColor="#1C1C19"
                                    FontSize="16"
                                    BackgroundColor="Transparent"
                                    VerticalOptions="Center"
                                    ClearButtonVisibility="WhileEditing" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Trường 2: Tên tài khoản / Email -->
                    <VerticalStackLayout Spacing="8" Margin="0,16,0,0">
                        <Label
                            Text="TÊN TÀI KHOẢN"
                            FontSize="12"
                            FontAttributes="Bold"
                            CharacterSpacing="1.5"
                            TextColor="#1C1C19" />

                        <Border
                            HeightRequest="50"
                            BackgroundColor="#FFFFFF"
                            Stroke="#D1C4B7"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 4">

                            <Grid ColumnDefinitions="42,*">
                                <Label
                                    Grid.Column="0"
                                    Text="♙"
                                    FontSize="20"
                                    TextColor="#80756A"
                                    HorizontalTextAlignment="Center"
                                    VerticalTextAlignment="Center" />

                                <Entry
                                    Grid.Column="1"
                                    x:Name="UsernameEntry"
                                    Placeholder="Nhập tên tài khoản"
                                    PlaceholderColor="#80756A"
                                    TextColor="#1C1C19"
                                    FontSize="16"
                                    BackgroundColor="Transparent"
                                    VerticalOptions="Center"
                                    ClearButtonVisibility="WhileEditing" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Trường 3: Mật khẩu -->
                    <VerticalStackLayout Spacing="8" Margin="0,16,0,0">
                        <Label
                            Text="MẬT KHẨU"
                            FontSize="12"
                            FontAttributes="Bold"
                            CharacterSpacing="1.5"
                            TextColor="#1C1C19" />

                        <Border
                            HeightRequest="50"
                            BackgroundColor="#FFFFFF"
                            Stroke="#D1C4B7"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 4">

                            <Grid ColumnDefinitions="42,*,45">
                                <Label
                                    Grid.Column="0"
                                    Text="🔒"
                                    FontSize="18"
                                    HorizontalTextAlignment="Center"
                                    VerticalTextAlignment="Center" />

                                <Entry
                                    Grid.Column="1"
                                    x:Name="PasswordEntry"
                                    Placeholder="Nhập mật khẩu"
                                    PlaceholderColor="#80756A"
                                    TextColor="#1C1C19"
                                    FontSize="16"
                                    IsPassword="True"
                                    BackgroundColor="Transparent"
                                    VerticalOptions="Center" />

                                <Button
                                    Grid.Column="2"
                                    Text="👁"
                                    BackgroundColor="Transparent"
                                    TextColor="#80756A"
                                    FontSize="18"
                                    Clicked="TogglePassword_Clicked"
                                    Padding="0" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Trường 4: Xác nhận Mật khẩu -->
                    <VerticalStackLayout Spacing="8" Margin="0,16,0,0">
                        <Label
                            Text="XÁC NHẬN MẬT KHẨU"
                            FontSize="12"
                            FontAttributes="Bold"
                            CharacterSpacing="1.5"
                            TextColor="#1C1C19" />

                        <Border
                            HeightRequest="50"
                            BackgroundColor="#FFFFFF"
                            Stroke="#D1C4B7"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 4">

                            <Grid ColumnDefinitions="42,*,45">
                                <Label
                                    Grid.Column="0"
                                    Text="🔒"
                                    FontSize="18"
                                    HorizontalTextAlignment="Center"
                                    VerticalTextAlignment="Center" />

                                <Entry
                                    Grid.Column="1"
                                    x:Name="ConfirmPasswordEntry"
                                    Placeholder="Nhập lại mật khẩu"
                                    PlaceholderColor="#80756A"
                                    TextColor="#1C1C19"
                                    FontSize="16"
                                    IsPassword="True"
                                    BackgroundColor="Transparent"
                                    VerticalOptions="Center" />

                                <Button
                                    Grid.Column="2"
                                    Text="👁"
                                    BackgroundColor="Transparent"
                                    TextColor="#80756A"
                                    FontSize="18"
                                    Clicked="ToggleConfirmPassword_Clicked"
                                    Padding="0" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Nút Đăng ký -->
                    <Button
                        x:Name="RegisterButton"
                        Text="Đăng ký"
                        HeightRequest="54"
                        Margin="0,28,0,0"
                        BackgroundColor="#8B6F47"
                        TextColor="White"
                        FontSize="20"
                        FontAttributes="Bold"
                        CornerRadius="4"
                        Clicked="RegisterButton_Clicked" />

                    <!-- Điều hướng quay lại Đăng nhập -->
                    <VerticalStackLayout Spacing="8" Margin="0,24,0,0">
                        <BoxView
                            HeightRequest="1"
                            Color="#D1C4B7"
                            Opacity="0.3" />

                        <HorizontalStackLayout
                            HorizontalOptions="Center"
                            Spacing="5"
                            Margin="0,16,0,0">

                            <Label
                                Text="Đã có tài khoản?"
                                FontSize="14"
                                TextColor="#4E453B" />

                            <Label
                                Text="Đăng nhập ngay"
                                FontSize="14"
                                FontAttributes="Bold"
                                TextColor="#8B6F47">

                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Tapped="Login_Tapped" />
                                </Label.GestureRecognizers>

                            </Label>

                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                </VerticalStackLayout>

            </Border>

        </ScrollView>

    </Grid>
</ContentPage>