<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Quanlyvadatphonghomestay.ChiTietHomestay"
             NavigationPage.HasNavigationBar="False"
             Title="ChiTietHomestay">
    <Grid RowDefinitions="*,Auto">

        <!-- ================= CONTENT CHÍNH ================= -->
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="0" Padding="0,0,0,20">

                <!-- 1. HERO IMAGE & NAVIGATION HEADER -->
                <Grid HeightRequest="300">
                    <!-- Ảnh bìa Homestay -->
                    <Image Source="{Binding ImageUrl}"
                           Aspect="AspectFill"
                           HorizontalOptions="Fill"
                           VerticalOptions="Fill" />

                    <!-- Lớp phủ tối nhẹ để nổi nút bấm -->
                    <BoxView BackgroundColor="#20000000" />

                    <!-- Nút Quay lại & Yêu thích -->
                    <Grid VerticalOptions="Start"
                          Padding="16,40,16,0"
                          ColumnDefinitions="Auto,*,Auto">
                        <Border Grid.Column="0"
                                WidthRequest="40" HeightRequest="40"
                                StrokeShape="RoundRectangle 20"
                                BackgroundColor="#CCFFFFFF"
                                StrokeThickness="0">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnBackClicked" />
                            </Border.GestureRecognizers>
                            <Label Text="‹" FontSize="28" TextColor="#3E3028" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>

                        <Border Grid.Column="2"
                                WidthRequest="40" HeightRequest="40"
                                StrokeShape="RoundRectangle 20"
                                BackgroundColor="#CCFFFFFF"
                                StrokeThickness="0">
                            <Label Text="❤️" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                    </Grid>

                    <!-- Số lượng ảnh Badge -->
                    <Border VerticalOptions="End" HorizontalOptions="End"
                            Margin="0,0,16,16" Padding="10,4"
                            BackgroundColor="#80000000"
                            StrokeShape="RoundRectangle 6"
                            StrokeThickness="0">
                        <Label Text="{Binding ImageCountText, FallbackValue='1/12'}"
                               TextColor="White" FontSize="11" FontAttributes="Bold" />
                    </Border>
                </Grid>

                <!-- 2. STRIP DANH SÁCH ẢNH NHỎ (THUMBNAILS) -->
                <CollectionView ItemsSource="{Binding Images}"
                                HeightRequest="70"
                                Margin="0,10,0,10"
                                HorizontalScrollBarVisibility="Never">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border WidthRequest="60" HeightRequest="60"
                                    StrokeShape="RoundRectangle 8"
                                    Stroke="#8B5E3C" StrokeThickness="1.5"
                                    Padding="0">
                                <Image Source="{Binding .}" Aspect="AspectFill" />
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- 3. THÔNG TIN HOMESTAY -->
                <VerticalStackLayout Padding="16,0" Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="{Binding Name, FallbackValue='An Nhiên Homestay'}"
                               FontSize="22" FontAttributes="Bold" TextColor="#3E3028" />

                        <HorizontalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="★" TextColor="#C89F72" FontSize="16" />
                            <Label Text="{Binding Rating, FallbackValue='4.8'}" FontAttributes="Bold" TextColor="#3E3028" FontSize="14"/>
                            <Label Text="{Binding ReviewCountText, FallbackValue='(256)'}" TextColor="#8A7A70" FontSize="12"/>
                        </HorizontalStackLayout>
                    </Grid>

                    <!-- Địa chỉ -->
                    <HorizontalStackLayout Spacing="4">
                        <Label Text="📍" FontSize="12" VerticalOptions="Center"/>
                        <Label Text="{Binding Address, FallbackValue='Sơn Trà, Đà Nẵng'}"
                               FontSize="13" TextColor="#8A7A70" />
                    </HorizontalStackLayout>

                    <!-- Badges Loại hình -->
                    <HorizontalStackLayout Spacing="8" Margin="0,4,0,0">
                        <Border BackgroundColor="#FFFDFC" Stroke="#E6D9CC" Padding="10,4" StrokeShape="RoundRectangle 6">
                            <Label Text="🏠 Homestay" TextColor="#6F452C" FontSize="11" FontAttributes="Bold" />
                        </Border>
                        <Border BackgroundColor="#FFFDFC" Stroke="#E6D9CC" Padding="10,4" StrokeShape="RoundRectangle 6">
                            <Label Text="🌊 View biển" TextColor="#6F452C" FontSize="11" FontAttributes="Bold" />
                        </Border>
                    </HorizontalStackLayout>
                </VerticalStackLayout>

                <BoxView HeightRequest="1" Color="#E6D9CC" Margin="16,16" />

                <!-- 4. GIỚI THIỆU -->
                <VerticalStackLayout Padding="16,0" Spacing="6">
                    <Label Text="Giới thiệu" FontSize="16" FontAttributes="Bold" TextColor="#3E3028" />
                    <Label Text="{Binding Description}"
                           FontSize="13" TextColor="#8A7A70" LineBreakMode="WordWrap" />
                </VerticalStackLayout>

                <BoxView HeightRequest="1" Color="#E6D9CC" Margin="16,16" />

                <!-- 5. TIỆN NGHI -->
                <VerticalStackLayout Padding="16,0" Spacing="12">
                    <Label Text="Tiện nghi" FontSize="16" FontAttributes="Bold" TextColor="#3E3028" />

                    <!-- FlexLayout Tiện Nghi -->
                    <FlexLayout BindableLayout.ItemsSource="{Binding Amenities}"
                                Wrap="Wrap" JustifyContent="Start" AlignItems="Center">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <VerticalStackLayout WidthRequest="70" Margin="0,0,8,12" HorizontalOptions="Center" Spacing="4">
                                    <Border WidthRequest="48" HeightRequest="48"
                                            BackgroundColor="#FFFDFC" Stroke="#E6D9CC"
                                            StrokeShape="RoundRectangle 12">
                                        <Label Text="{Binding Icon}" FontSize="20"
                                               HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <Label Text="{Binding Title}" FontSize="11" TextColor="#3E3028"
                                           HorizontalTextAlignment="Center" LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                </VerticalStackLayout>

                <BoxView HeightRequest="1" Color="#E6D9CC" Margin="16,8" />

                <!-- 6. DANH SÁCH PHÒNG (ROOMS) -->
                <VerticalStackLayout Padding="16,0" Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Các phòng" FontSize="16" FontAttributes="Bold" TextColor="#3E3028" />
                        <Label Grid.Column="1" Text="Xem tất cả ›" TextColor="#8B5E3C" FontSize="12" FontAttributes="Bold" VerticalOptions="Center"/>
                    </Grid>

                    <CollectionView ItemsSource="{Binding Rooms}" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="#FFFDFC" Stroke="#E6D9CC"
                                        StrokeShape="RoundRectangle 16" Padding="10" Margin="0,0,0,12">
                                    <Grid ColumnDefinitions="100,*" ColumnSpacing="12">
                                        <!-- Ảnh phòng -->
                                        <Border Grid.Column="0" HeightRequest="90" StrokeShape="RoundRectangle 12" Padding="0">
                                            <Image Source="{Binding ImageUrl}" Aspect="AspectFill" />
                                        </Border>

                                        <!-- Dữ liệu phòng -->
                                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                                            <Label Text="{Binding RoomName}" FontSize="14" FontAttributes="Bold" TextColor="#3E3028" />
                                            <Label Text="{Binding RoomCapacityText}" FontSize="11" TextColor="#8A7A70" />

                                            <Grid ColumnDefinitions="*,Auto" VerticalOptions="EndAndExpand" Margin="0,6,0,0">
                                                <HorizontalStackLayout Spacing="2">
                                                    <Label Text="{Binding Price, StringFormat='{0:N0}đ'}" FontSize="14" FontAttributes="Bold" TextColor="#8B5E3C" />
                                                    <Label Text="/ đêm" FontSize="10" TextColor="#8A7A70" VerticalOptions="Center"/>
                                                </HorizontalStackLayout>

                                                <Button Grid.Column="1" Text="Chọn phòng"
                                                        BackgroundColor="#8B5E3C" TextColor="White"
                                                        CornerRadius="16" HeightRequest="32" Padding="12,0" FontSize="11"
                                                        Clicked="OnSelectRoomClicked" CommandParameter="{Binding .}"/>
                                            </Grid>
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <!-- 7. ĐÁNH GIÁ (REVIEWS) -->
                <VerticalStackLayout Padding="16,10" Spacing="12">
                    <Label Text="Đánh giá" FontSize="16" FontAttributes="Bold" TextColor="#3E3028" />

                    <CollectionView ItemsSource="{Binding Reviews}" HeightRequest="130" HorizontalScrollBarVisibility="Never">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="12" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border WidthRequest="220" BackgroundColor="#FFFDFC"
                                        Stroke="#E6D9CC" StrokeShape="RoundRectangle 16" Padding="12">
                                    <VerticalStackLayout Spacing="4">
                                        <Grid ColumnDefinitions="Auto,*">
                                            <Border WidthRequest="30" HeightRequest="30" StrokeShape="RoundRectangle 15" Padding="0">
                                                <Image Source="{Binding UserAvatar}" Aspect="AspectFill"/>
                                            </Border>
                                            <VerticalStackLayout Grid.Column="1" Margin="8,0,0,0" VerticalOptions="Center">
                                                <Label Text="{Binding UserName}" FontSize="12" FontAttributes="Bold" TextColor="#3E3028" />
                                                <Label Text="{Binding DateText}" FontSize="10" TextColor="#8A7A70" />
                                            </VerticalStackLayout>
                                        </Grid>
                                        <Label Text="{Binding Comment}" FontSize="11" TextColor="#8A7A70" LineBreakMode="TailTruncation" MaxLines="3" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- ================= FIXED BOTTOM BOOKING BAR ================= -->
        <Border Grid.Row="1" BackgroundColor="#FFFDFC" Stroke="#E6D9CC"
                Padding="16,12" StrokeThickness="1">
            <Grid ColumnDefinitions="*,Auto">
                <VerticalStackLayout VerticalOptions="Center">
                    <HorizontalStackLayout Spacing="2">
                        <Label Text="Từ " FontSize="12" TextColor="#8A7A70" VerticalOptions="Center"/>
                        <Label Text="{Binding Price, StringFormat='{0:N0}đ'}" FontSize="18" FontAttributes="Bold" TextColor="#8B5E3C" />
                        <Label Text=" / đêm" FontSize="12" TextColor="#8A7A70" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                    <Label Text="Giá có thể thay đổi theo ngày" FontSize="10" TextColor="#8A7A70"/>
                </VerticalStackLayout>

                <Button Grid.Column="1" Text="Đặt phòng"
                        BackgroundColor="#8B5E3C" TextColor="White"
                        FontAttributes="Bold" CornerRadius="22"
                        HeightRequest="44" Padding="24,0"
                        Clicked="OnBookingClicked"/>
            </Grid>
        </Border>

    </Grid>
</ContentPage>